# HiveMI - Environment Variables

# ===================
# Core
# ===================

# Shared secret for inter-component auth
HIVEMI_SECRET=change-me-in-production

# Environment
NODE_ENV=development

# ===================
# Registry
# ===================

REGISTRY_PORT=4001
REGISTRY_HOST=0.0.0.0

# ===================
# Manager
# ===================

MANAGER_PORT=4000
MANAGER_HOST=0.0.0.0

# Registry URL (Manager connects to Registry)
REGISTRY_URL=http://localhost:4001

# ===================
# Database (PostgreSQL)
# ===================

DATABASE_URL=postgresql://hivemi:hivemi@localhost:5432/hivemi

# ===================
# LLM Providers
# ===================

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Default model
DEFAULT_MODEL=gpt-4o

# ===================
# Agent Settings
# ===================

# Heartbeat interval in seconds
AGENT_HEARTBEAT_INTERVAL=30

# Request timeout in seconds
AGENT_REQUEST_TIMEOUT=30

# Max retries for P2P messages
AGENT_MAX_RETRIES=3

# ===================
# Logging
# ===================

# Log level: debug, info, warn, error
LOG_LEVEL=info
